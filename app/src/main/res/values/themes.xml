<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Everything visual is defined in Compose; this theme exists only so the window
         matches the app's first frame instead of flashing white. -->
    <style name="Theme.Danak" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/danak_launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch theme: the sprout on the app's own background, held until state loads. -->
    <style name="Theme.Danak.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/danak_launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Danak</item>
    </style>
</resources>
