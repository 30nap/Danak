<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Everything visual is defined in Compose; this theme exists only so the launch
         window matches the app's first frame instead of flashing white. -->
    <style name="Theme.Danak" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/danak_launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
