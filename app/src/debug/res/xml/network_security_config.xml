<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Instrumented tests serve published content from MockWebServer on the
  device itself, over plain HTTP. Everything else keeps the platform default (https only),
  and release builds do not have this file at all.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
