{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdicts",
    "unclaimedStatements",
    "notes"
  ],
  "properties": {
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "status",
          "reason",
          "evidence",
          "sourceReliabilityConcern"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "status": {
            "enum": [
              "SUPPORTED",
              "PARTIALLY_SUPPORTED",
              "UNSUPPORTED",
              "CONTRADICTED",
              "UNCERTAIN"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "block",
                "excerpt"
              ],
              "properties": {
                "block": {
                  "type": "integer"
                },
                "excerpt": {
                  "type": "string"
                }
              }
            }
          },
          "sourceReliabilityConcern": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "unclaimedStatements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "location",
          "text",
          "reason"
        ],
        "properties": {
          "location": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "title": "Danak verification stage answer, v1"
}
